# vim: syntax=python expandtab
# Compare and evaluate adapter and quality trimming tools.
# Original implementation by Brian Bushnell (2014): 
#   http://seqanswers.com/forums/showthread.php?t=42776
# "gruseq" adapters downloaded from:
#   http://seqanswers.com/forums/attachment.php?attachmentid=2993&d=1398383571
# Fredrik Boulund 2019

import random
import gzip
import os

configfile: "config/config.yaml"

TOOLS=[
    "cutadapt",
    "trimmomatic",
    "bbduk",
    "fastp",
    "adapterremoval",
    "fasten",
]

rule all:
    input:
        expand("output/grades/{tool}.grade.txt", tool=TOOLS),
        expand("output/plots/{plot}.pdf", plot=["benchmarks", "grades"]),


## Download data if requested by config, else use provided example testing data.
data_path = "output/data.fastq.gz"
if config["download_FASTQ"]:
    rule download_fastq:
        output:
            data_path
        conda: "envs/main.yaml"
        params:
            fastq=config["download_FASTQ"]
        shell:
            """
            wget --output-document {output} {params.fastq}
            """
else:
    if os.path.isfile(data_path):
        print("INFO: download_FASTQ is set to False and '{data_path}' already exists, doing nothing.")
    else:
        print("INFO: Symlinking example FASTQ 'data/SRR9218144.888888.fastq.gz' to 'output/data.fastq.gz'.")
        os.makedirs("output", exist_ok=True)
        os.symlink("../data/SRR9218144.888888.fastq.gz", "output/data.fastq.gz")


rule add_adapters:
    input:
        fastq="output/data.fastq.gz",
        adapters="gruseq.fa",
    output:
        "output/dirty.fq"
    log: "output/logs/add_adapters.log"
    conda: "envs/main.yaml"
    shell:
        """
        addadapters.sh \
            in={input.fastq} \
            out={output} \
            qout=33 \
            ref={input.adapters} \
            right \
            int=f \
            2> {log}
        """

rule cutadapt:
    input:
        fastq=rules.add_adapters.output,
        adapters="gruseq.fa",
    output:
        "output/processed/cutadapt.fq"
    log: "output/logs/cutadapt.log"
    conda: "envs/cutadapt.yaml"
    threads: config["threads"]
    benchmark:
        repeat("output/benchmarks/cutadapt.benchmark.txt", config["replicates"])
    shell:
        """
        cutadapt \
            --cores {threads} \
            --minimum-length 10 \
            --anywhere CTGACCTTCTCATATACGAGCTTAGAATCGATATGATACTGAGACGTGCAACGAGGAGCAGGC \
            --anywhere CTGACCTTCTCATATACGAGCTTAGAATCGATAACTGCGTGAGACGTGCAACGAGGAGCAGGC \
