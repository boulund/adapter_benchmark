            {input.fastq} \
            > {output} \
            2> {log}
        """

rule trimmomatic:
    input:
        fastq=rules.add_adapters.output,
        adapters="gruseq.fa",
    output:
        "output/processed/trimmomatic.fq"
    conda: "envs/trimmomatic.yaml"
    log: "output/logs/trimmomatic.log"
    threads: config["threads"]
    benchmark:
        repeat("output/benchmarks/trimmomatic.benchmark.txt", config["replicates"])
    shell:
        """
        trimmomatic \
            SE \
            -phred33 \
            -threads {threads} \
            {input.fastq} \
            {output} \
            ILLUMINACLIP:gruseq.fa:2:28:10 \
            MINLEN:10 \
            2> {log}
        """


rule bbduk:
    input:
        fastq=rules.add_adapters.output,
        adapters="gruseq.fa",
    output:
        "output/processed/bbduk.fq"
    conda: "envs/main.yaml"
    log: "output/logs/bbduk.log"
    threads: config["threads"]
    benchmark:
        repeat("output/benchmarks/bbduk.benchmark.txt", config["replicates"])
    shell:
        """
        bbduk.sh \
            in={input.fastq} \
            out={output} \
            ref={input.adapters} \
            ktrim=r \
            mink=12 \
            hdist=1 \
            minlen=10 \
            threads={threads} \
            2> {log}
        """

rule fastp:
    input:
        fastq=rules.add_adapters.output,
        adapters="gruseq.fa",
    output:
        fq="output/processed/fastp.fq",
        html="output/processed/fastp.html",
        json="output/processed/fastp.json",
    conda: "envs/fastp.yaml"
    log: "output/logs/fastp.log"
    threads: config["threads"]
    benchmark:
        repeat("output/benchmarks/fastp.benchmark.txt", config["replicates"])
    shell:
        """
        fastp \
            --in1 {input.fastq} \
            --out1 {output.fq} \
            --adapter_fasta {input.adapters} \
            --thread {threads} \
            --html {output.html} \
            --json {output.json} \
            --length_required 10 \
            2> {log}
        """

rule adapterremoval:
    input:
        fastq=rules.add_adapters.output,
        adapters="gruseq.txt",
    output:
        fq="output/processed/adapterremoval.fq",
    conda: "envs/adapterremoval.yaml"
    log: "output/logs/adapterremoval.log"
    threads: config["threads"]
    shadow: "shallow"
    benchmark:
        repeat("output/benchmarks/adapterremoval.benchmark.txt", config["replicates"])
    shell:
        """
        AdapterRemoval \
            --file1 {input.fastq} \
            --output1 {output.fq} \
            --adapter-list {input.adapters} \
            --thread {threads} \
            2> {log}
        """

rule fasten:
    input:
        fastq=rules.add_adapters.output,
        adapters="gruseq.fa",
    output:
        "output/processed/fasten.fq"
    conda: "envs/fasten.yaml"
    log: "output/logs/fasten.log"
    threads: config["threads"]
    benchmark:
        repeat("output/benchmarks/fasten.benchmark.txt", config["replicates"])
    shell:
        """
        fasten_trim \
          --adapterseqs {input.adapters} \
          --numcpus {threads} \
          < {input.fastq} \
          > {output} \
          2> {log};
        """

rule grade:
    input:
        "output/processed/{tool}.fq"
    output:
        "output/grades/{tool}.grade.txt"
    conda: "envs/main.yaml"
    shell:
        """
        addadapters.sh \
            in={input} \
            grade \
            2> {output}
        """

rule plot:
    input:
        benchmarks=expand("output/benchmarks/{tool}.benchmark.txt", tool=TOOLS),
        grades=expand("output/grades/{tool}.grade.txt", tool=TOOLS),
    output:
        benchmarks="output/plots/benchmarks.pdf",
        grades="output/plots/grades.pdf",
    conda: "envs/main.yaml"
    shell:
        """
        workflow/scripts/plot_benchmarks.py \
            --output {output.benchmarks} \
            {input.benchmarks}
        workflow/scripts/plot_grades.py \
            --output {output.grades} \
            {input.grades}
        """


